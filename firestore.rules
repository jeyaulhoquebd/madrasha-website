rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Public institutional read collections (Admin write only)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /routines/{routineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admission applications: Public can submit; Admin can view/manage
    match /admissions/{admissionId} {
      allow create: if request.resource.data.keys().hasAll(['studentName', 'phone', 'classApplied']) &&
                       request.resource.data.studentName is string &&
                       request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages / inquiries: Public can create, Admin can read/delete
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'message']) &&
                       request.resource.data.name is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Admin profiles: Only authenticated admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAuthenticated() && request.auth.uid == adminId;
    }
  }
}
