rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    // Primary administrator (Firebase Authentication UID).
    // To add another admin: append the UID to this list (and to ADMIN_UIDS in
    // public/assets/js/firebase/config.js), or create admins/{uid} in the Console.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid in ['8ALeLYl29me8iozWeTVFoe0FIJ63'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Moderator: an active record at moderators/{uid} created by an admin.
    // can(section) = admin, or an active moderator who was given that section.
    function can(section) {
      let path = /databases/$(database)/documents/moderators/$(request.auth.uid);
      return isAdmin() || (
        isAuthenticated()
        && exists(path)
        && get(path).data.active == true
        && section in get(path).data.get('permissions', [])
      );
    }

    function str(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    function optStr(field, maxLen) {
      return !(field in request.resource.data) || str(field, maxLen);
    }

    // Approved guardian who is linked to this student ID by an admin
    function isGuardianOf(studentId) {
      let path = /databases/$(database)/documents/guardians/$(request.auth.uid);
      return isAuthenticated()
        && exists(path)
        && get(path).data.status == 'approved'
        && studentId in get(path).data.get('studentIds', []);
    }

    // ---------- Public website content (anyone reads, only admins write) ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if can('settings');
    }

    match /teachers/{id}       { allow read: if true; allow write: if can('teachers'); }
    match /staff/{id}          { allow read: if true; allow write: if can('staff'); }
    match /administration/{id} { allow read: if true; allow write: if can('administration'); }
    match /departments/{id}    { allow read: if true; allow write: if can('departments'); }
    match /routines/{id}       { allow read: if true; allow write: if can('routines'); }
    match /downloads/{id}      { allow read: if true; allow write: if can('downloads'); }
    match /gallery/{id}        { allow read: if true; allow write: if can('gallery'); }
    match /calendar/{id}       { allow read: if true; allow write: if can('calendar'); }

    // Notices & results: the public sees only published documents
    match /notices/{id} {
      allow read: if resource.data.isPublished == true || can('notices');
      allow write: if can('notices');
    }

    match /results/{id} {
      allow read: if resource.data.isPublished == true || can('results');
      allow write: if can('results');
    }

    // ---------- Public submissions (anyone creates, only admins read/manage) ----------
    match /admissions/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                        'classApplied', 'level', 'session', 'photo',
                        'studentName', 'studentNameEn', 'dateOfBirth', 'gender', 'birthRegNo', 'nid', 'bloodGroup',
                        'fatherName', 'fatherPhone', 'fatherNid', 'fatherOccupation',
                        'motherName', 'motherPhone', 'motherNid',
                        'guardianName', 'guardianRelation', 'guardianPhone',
                        'presentAddress', 'permanentAddress',
                        'previousSchool', 'previousClass', 'previousResult',
                        'prevExamRoll', 'prevExamReg', 'prevExamYear', 'prevBoard',
                        'notes', 'phone', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['classApplied', 'studentName', 'fatherName', 'fatherPhone', 'motherName', 'birthRegNo', 'photo', 'phone'])
                    && str('classApplied', 60) && request.resource.data.classApplied.size() > 0
                    && optStr('level', 20) && optStr('session', 10)
                    && ((str('photo', 250000) && request.resource.data.photo.matches('data:image/jpeg;base64,.*'))
                        || (str('photo', 500) && request.resource.data.photo.matches('https://res[.]cloudinary[.]com/ouertwph/image/upload/.*')))
                    && str('studentName', 100) && request.resource.data.studentName.size() > 0
                    && optStr('studentNameEn', 100) && optStr('dateOfBirth', 20) && optStr('gender', 10)
                    && str('birthRegNo', 20) && optStr('nid', 20) && optStr('bloodGroup', 10)
                    && str('fatherName', 100) && str('fatherPhone', 20) && optStr('fatherNid', 20) && optStr('fatherOccupation', 60)
                    && str('motherName', 100) && optStr('motherPhone', 20) && optStr('motherNid', 20)
                    && optStr('guardianName', 100) && optStr('guardianRelation', 40) && optStr('guardianPhone', 20)
                    && optStr('presentAddress', 300) && optStr('permanentAddress', 300)
                    && optStr('previousSchool', 150) && optStr('previousClass', 60) && optStr('previousResult', 30)
                    && optStr('prevExamRoll', 20) && optStr('prevExamReg', 20) && optStr('prevExamYear', 4) && optStr('prevBoard', 60)
                    && optStr('notes', 500)
                    && str('phone', 20)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if can('admissions');
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'subject', 'message', 'createdAt'])
                    && str('name', 100) && request.resource.data.name.size() > 0
                    && str('phone', 20)
                    && optStr('email', 120)
                    && optStr('subject', 60)
                    && str('message', 2000) && request.resource.data.message.size() > 0
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if can('messages');
    }

    // ---------- Students (private: admins + their own approved guardians) ----------
    match /students/{studentId} {
      allow read: if can('students') || isGuardianOf(studentId);
      allow write: if can('students');

      match /results/{resultId} {
        allow read: if can('students') || (isGuardianOf(studentId) && resource.data.isPublished == true);
        allow write: if can('students');
      }
    }

    // ---------- Guardian accounts ----------
    // A signed-in user may create ONLY their own record, always as "pending"
    // and without any linked students. Only admins can approve / link students.
    match /guardians/{uid} {
      allow create: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'relation', 'phone', 'email', 'requestedStudentId', 'studentName', 'status', 'createdAt'])
                    && str('name', 100) && request.resource.data.name.size() > 0
                    && str('relation', 30) && str('phone', 20)
                    && str('email', 120) && request.resource.data.email == request.auth.token.email
                    && str('requestedStudentId', 40) && request.resource.data.requestedStudentId.size() > 0
                    && optStr('studentName', 100)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;
      allow read: if (isAuthenticated() && request.auth.uid == uid) || can('guardians');
      allow update, delete: if can('guardians');
    }

    // ---------- Moderators (only admins manage; a moderator reads own record) ----------
    match /moderators/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---------- Admin registry ----------
    // A user may only read their own record. Nobody can write it from the
    // website: add extra admins from the Firebase Console.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
