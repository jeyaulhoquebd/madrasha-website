{
  "name": "madrasha-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/assets/css/output.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/assets/css/output.css --watch",
    "build": "tailwindcss -i ./styles/input.css -o ./public/assets/css/output.css --minify && vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
